{
  "manifest_version": 3,
  "name": "LeakLock",
  "short_name": "LeakLock",
  "version": "1.0.1",
  "description": "Active image privacy protection - analyzes images before you upload them.",
  "homepage_url": "https://lior-benjman.github.io/LeakLock/",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://leaklock-api-799658247857.us-central1.run.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
